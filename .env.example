# Adresse du projet Supabase (publique), lue par le navigateur (administration).
VITE_SUPABASE_URL=
# Clé anonyme Supabase (publique), lue par le navigateur (administration).
VITE_SUPABASE_ANON_KEY=
# Adresse du projet Supabase, lue au build par scripts/fetch-content.mjs.
SUPABASE_URL=
# Clé anonyme Supabase, lue au build par scripts/fetch-content.mjs.
SUPABASE_ANON_KEY=
# Netlify seulement (variables d'environnement du site, jamais dans ce fichier ni dans le dépôt) :
# la fonction de publication lit BUILD_HOOK_URL (adresse secrète du « build hook »), en plus de SUPABASE_URL et SUPABASE_ANON_KEY ci-dessus.
# Poste local seulement, dans .env.local (ignoré par git) ou en variable d'environnement, jamais dans Netlify :
# `npm run seed:db` lit SUPABASE_SERVICE_ROLE_KEY (clé service_role du projet, tous les droits) avec SUPABASE_URL ci-dessus.
